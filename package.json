{
  "name": "eslint-plugin-json-canonical",
  "description": "ESLint plugin enforcing RFC 8785 (JSON Canonicalization Scheme)",
  "version": "2.1.2",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@eslint/json": "^2.1.0",
    "@exadev/eslint-config": "2.17.0",
    "@humanwhocodes/momoa": "3.3.13",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@stryker-mutator/api": "10.0.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.5.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": ">=10.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "publint": "0.3.24",
    "semantic-release": "25.0.9",
    "tsdown": "0.23.0",
    "turbo": "2.11.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "jcs",
    "json",
    "json-canonicalization",
    "rfc8785"
  ],
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "peerDependencies": {
    "@eslint/json": "^2.1.0",
    "eslint": ">=10.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExaDev/eslint-plugin-json-canonical.git"
  },
  "scripts": {
    "_attw": "attw --pack",
    "_build": "tsdown",
    "_lint": "eslint . --fix --cache --max-warnings 0",
    "_publint": "publint",
    "_test": "vitest run",
    "_test:mutation": "stryker run stryker.config.ts",
    "_typecheck": "tsc -p tsconfig.json",
    "build": "turbo run _build",
    "lint": "turbo run _lint",
    "prepare": "husky",
    "prepublishOnly": "turbo run _prepublish",
    "release": "semantic-release",
    "test": "turbo run _test",
    "test:mutation": "turbo run _test:mutation",
    "typecheck": "turbo run _typecheck"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts"
}
